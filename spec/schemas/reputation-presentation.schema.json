{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crewport-repos/AICP/spec/schemas/reputation-presentation.schema.json",
  "title": "AICP reputation presentation",
  "description": "What a subject or issuer hands a verifier (§6.4.6, §6.4.10). Per-entry inclusion_path is optional and verifiers MUST ignore it. Verifiers MUST use the signed subject_map_size, not the presenter's map_size, except to reject a mismatch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["history_proof", "disclosures"],
  "properties": {
    "attestation": {
      "type": "string",
      "minLength": 1,
      "description": "Card attestation JWS. Required when history_proof is an inclusion proof."
    },
    "sth": {
      "type": "string",
      "minLength": 1,
      "description": "Optional stapled signed tree head. Used only when fresh and consistent with STHs the verifier already holds."
    },
    "consistency_path": {
      "type": "array",
      "items": {"$ref": "#/$defs/hash"},
      "description": "RFC 9162 consistency proof from log_proof.tree_size to the STH the verifier accepts."
    },
    "history_proof": {"$ref": "#/$defs/history_proof"},
    "disclosures": {
      "type": "array",
      "items": {"$ref": "#/$defs/disclosure"}
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["history_proof"],
        "properties": {
          "history_proof": {
            "type": "object",
            "required": ["checkpoint"]
          }
        }
      },
      "then": {"required": ["attestation"]}
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "sub", "count", "history_root", "index_entry", "latest_entry"],
      "properties": {
        "v": {"const": 1},
        "sub": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1},
        "history_root": {"$ref": "#/$defs/hash"},
        "index_entry": {"type": "integer", "minimum": 0},
        "latest_entry": {"type": "integer", "minimum": 0}
      }
    },
    "log_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "entry_type", "iss", "sub", "jti", "iat"],
      "properties": {
        "v": {"const": 1},
        "entry_type": {"type": "string", "enum": ["attestation", "revocation", "correction"]},
        "iss": {"type": "string", "minLength": 1},
        "sub": {"type": "string", "minLength": 1},
        "jti": {"type": "string", "minLength": 1},
        "iat": {"type": "integer", "minimum": 0},
        "event": {"type": "string", "enum": ["contract_completed", "outcome", "rating", "dispute_result"]},
        "detail_commit": {"$ref": "#/$defs/hash"},
        "counterparty_id": {"type": "string", "minLength": 1},
        "settlement_hash": {"$ref": "#/$defs/hash"},
        "target_jti": {"type": "string", "minLength": 1},
        "target_index": {"type": "integer", "minimum": 0},
        "reason": {"type": "string", "enum": ["outcome_reversed", "dispute_upheld", "error", "other"]}
      }
    },
    "subject_index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "entry_type", "iss", "sub", "jti", "iat", "count", "indices", "history_root"],
      "properties": {
        "v": {"const": 1},
        "entry_type": {"const": "subject_index"},
        "iss": {"type": "string", "minLength": 1},
        "sub": {"type": "string", "minLength": 1},
        "jti": {"type": "string", "minLength": 1},
        "iat": {"type": "integer", "minimum": 0},
        "count": {"type": "integer", "minimum": 1},
        "indices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "history_root": {"$ref": "#/$defs/hash"}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "salt", "detail"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "salt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,}$",
          "description": "base64url of at least 16 salt bytes."
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "outcome": {"type": "string", "enum": ["fulfilled", "reversed"]},
            "amount_minor": {"type": "integer", "minimum": 0},
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
          }
        }
      }
    },
    "neighbor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint", "map_index", "map_inclusion_path"],
      "properties": {
        "checkpoint": {"$ref": "#/$defs/checkpoint"},
        "map_index": {"type": "integer", "minimum": 0},
        "map_inclusion_path": {
          "type": "array",
          "items": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "entry"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "entry": {"$ref": "#/$defs/log_entry"},
        "inclusion_path": {
          "type": "array",
          "items": {"$ref": "#/$defs/hash"},
          "description": "OPTIONAL. Verifiers MUST ignore this path. Monitors check per-entry inclusion."
        }
      }
    },
    "inclusion_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint",
        "map_index",
        "map_size",
        "map_inclusion_path",
        "index_entry",
        "index_entry_inclusion_path",
        "entries"
      ],
      "properties": {
        "checkpoint": {"$ref": "#/$defs/checkpoint"},
        "map_index": {"type": "integer", "minimum": 0},
        "map_size": {"type": "integer", "minimum": 1},
        "map_inclusion_path": {
          "type": "array",
          "items": {"$ref": "#/$defs/hash"}
        },
        "index_entry": {"$ref": "#/$defs/subject_index"},
        "index_entry_inclusion_path": {
          "type": "array",
          "items": {"$ref": "#/$defs/hash"}
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/history_entry"}
        }
      }
    },
    "non_inclusion_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "non_inclusion"],
      "properties": {
        "entries": {
          "type": "array",
          "maxItems": 0
        },
        "non_inclusion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sub"],
          "properties": {
            "sub": {"type": "string", "minLength": 1},
            "left": {"$ref": "#/$defs/neighbor"},
            "right": {"$ref": "#/$defs/neighbor"}
          }
        }
      }
    },
    "history_proof": {
      "oneOf": [
        {"$ref": "#/$defs/inclusion_proof"},
        {"$ref": "#/$defs/non_inclusion_proof"}
      ]
    }
  }
}
