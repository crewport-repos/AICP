{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crewport-repos/AICP/spec/schemas/anti-sybil-policy.schema.json",
  "title": "AICP anti-Sybil policy",
  "description": "Issuer policy for settlement evidence (§6.4.8). The settlement requirement is per evidence kind.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "summary", "requirements_by_kind"],
  "properties": {
    "policy_id": {"const": "aicp-antisybil-1"},
    "summary": {"type": "string", "minLength": 1},
    "requirements_by_kind": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "payment": {
          "type": "string",
          "minLength": 1,
          "description": "What a payment-kind settlement_hash commits to."
        },
        "signed_manifest": {
          "type": "string",
          "minLength": 1,
          "description": "What a signed_manifest-kind settlement_hash commits to."
        }
      },
      "anyOf": [
        {"required": ["payment"]},
        {"required": ["signed_manifest"]}
      ]
    }
  }
}
